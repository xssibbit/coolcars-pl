# PostgreSQL / Neon / Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random value (32+ chars) for production
SESSION_SECRET="replace-with-at-least-32-random-characters"

# The account registered with this email receives ADMIN role automatically
ADMIN_EMAIL="owner@example.com"

# Added automatically by Vercel when a Blob store is connected to this project
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

NEXT_PUBLIC_SITE_NAME="CoolCars"
