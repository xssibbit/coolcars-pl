generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  DRAFT
}

enum InquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATION
  WON
  LOST
}

enum AnalyticsEventType {
  VIEW
  CALL
  INQUIRY
  FAVORITE
  COMPARE
  QUICK_VIEW
  WON
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(USER)
  favorites       Favorite[]
  inquiries       Inquiry[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Vehicle {
  id              String           @id @default(cuid())
  slug            String           @unique
  stockNumber     String           @unique
  title           String
  brand           String
  model           String
  year            Int
  mileage         Int
  priceNet        Int
  vatRate         Int              @default(23)
  category        String
  fuel            String
  transmission    String
  powerHp         Int?
  engineCapacity  Int?
  dmc             Int?
  payload         Int?
  location        String           @default("Polska")
  description     String
  status          VehicleStatus    @default(AVAILABLE)
  featured        Boolean          @default(false)
  image           String           @default("/vehicles/truck-1.svg")
  images          VehicleImage[]
  favorites       Favorite[]
  inquiries       Inquiry[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([brand])
  @@index([category])
  @@index([status])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  sortOrder Int      @default(0)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([vehicleId, sortOrder])
}

model Favorite {
  userId    String
  vehicleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, vehicleId])
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  message       String
  status        InquiryStatus @default(NEW)
  adminNote     String?
  nextFollowUp  DateTime?
  visitorId     String?
  source        String?
  medium        String?
  campaign      String?
  firstSource   String?
  firstMedium   String?
  firstCampaign String?
  landingPath   String?
  userId        String?
  vehicleId     String
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([nextFollowUp])
  @@index([source, createdAt])
  @@index([campaign, createdAt])
}

model AnalyticsEvent {
  id            String             @id @default(cuid())
  type          AnalyticsEventType
  vehicleId     String?
  userId        String?
  visitorId     String?
  source        String?
  medium        String?
  campaign      String?
  firstSource   String?
  firstMedium   String?
  firstCampaign String?
  referrerHost  String?
  landingPath   String?
  vehicle       Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([type, createdAt])
  @@index([vehicleId, createdAt])
  @@index([visitorId, createdAt])
  @@index([source, createdAt])
  @@index([campaign, createdAt])
}
